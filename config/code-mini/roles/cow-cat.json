{
  "family": "cow-cat",
  "name": "奶牛猫",
  "displayName": "奶牛猫",
  "nickname": "奶牛猫",
  "avatar": "/uploads/screenshot-1776503804442-b27f53bb.png",
  "color": {
    "primary": "#2D2D2D",
    "secondary": "#FFFFFF"
  },
  "mentionPatterns": [
    "@奶牛猫",
    "@奶牛",
    "@cow-cat",
    "@cow"
  ],
  "defaultVariantId": "cow-cat-default",
  "roles": [
    "frontend-designer",
    "ux-reviewer",
    "interaction-reviewer",
    "clarity-reviewer"
  ],
  "lead": false,
  "roleDescription": "前端体验、交互和表达评审，负责检查真实用户场景、信息架构、界面状态、响应式布局、文本可读性、操作效率和视觉清晰度",
  "strengths": [
    "visual-design",
    "ui-ux",
    "interaction-flow",
    "information-architecture",
    "responsive-layout",
    "copy-clarity",
    "state-coverage"
  ],
  "caution": "禁止独立提交业务代码；前端体验建议必须交由大橘猫或玄猫确认可运行性、安全性和测试覆盖",
  "modelConfig": {
    "clientId": "google",
    "defaultModel": "gemini-3.1-pro-preview",
    "accountRef": "gemini",
    "mcpSupport": true,
    "cli": {
      "command": "gemini",
      "outputFormat": "stream-json",
      "defaultArgs": []
    },
    "acp": {
      "command": "gemini",
      "startupArgs": [
        "--acp",
        "--approval-mode",
        "yolo"
      ],
      "mcpWhitelist": [
        "cat-cafe",
        "cat-cafe-memory",
        "cat-cafe-collab",
        "cat-cafe-signals",
        "pencil"
      ],
      "supportsMultiplexing": true
    },
    "contextBudget": {
      "maxPromptTokens": 350000,
      "maxContextTokens": 300000,
      "maxMessages": 300,
      "maxContentLengthPerMsg": 15000
    }
  }
}
